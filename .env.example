APP_NAME="Fanmerch"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Jika pakai MySQL, ganti baris di atas jadi DB_CONNECTION=mysql lalu isi baris di bawah:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=fanmerch
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@fanmerch.test"
MAIL_FROM_NAME="${APP_NAME}"

# ==== MIDTRANS PAYMENT GATEWAY ====
# Ambil dari dashboard.midtrans.com > Settings > Access Keys (mode SANDBOX dulu untuk testing)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true
